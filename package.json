{
  "name": "litellm-opencode-plugin",
  "version": "1.0.0-0c824ad",
  "description": "OpenCode plugin that shows LiteLLM spend and budget usage in the TUI footer",
  "license": "MIT",
  "author": "Alysson Malagutte (https://github.com/Malagutte)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Malagutte/litellm-opencode-plugin.git"
  },
  "homepage": "https://github.com/Malagutte/litellm-opencode-plugin#readme",
  "bugs": {
    "url": "https://github.com/Malagutte/litellm-opencode-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "litellm",
    "spend",
    "budget",
    "tui"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build:gui": "vite build",
    "prepublishOnly": "npm run build:gui && npm run typecheck && npm test && npm run check:package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "version:print": "node scripts/version.mjs",
    "version:sync": "node scripts/version.mjs --sync",
    "version:check": "node scripts/version.mjs --check",
    "version:check:exact": "node scripts/version.mjs --check --exact"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.3.0",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "@types/node": "^22.10.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
